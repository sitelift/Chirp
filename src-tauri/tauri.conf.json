{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chirp",
  "version": "2.0.0",
  "identifier": "com.chirp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Chirp",
        "width": 136,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://huggingface.co https://*.huggingface.co https://github.com https://objects.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sitelift/Chirp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBN0NGMzkxQ0YxQjE3QzAKUldUQUZ4dlBrZk44dWd5VjVxc0ZBa2FRalY2b04yV0xROHRwL0FKSTBpMjJqNkZObkt5bEpiNG0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "sherpa-onnx-c-api.dll",
      "sherpa-onnx-cxx-api.dll",
      "onnxruntime.dll",
      "onnxruntime_providers_shared.dll",
      "concrt140.dll",
      "msvcp140.dll",
      "msvcp140_1.dll",
      "msvcp140_2.dll",
      "msvcp140_atomic_wait.dll",
      "msvcp140_codecvt_ids.dll",
      "vcruntime140.dll",
      "vcruntime140_1.dll",
      "vcruntime140_threads.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/chirp-header.bmp",
        "sidebarImage": "installer/chirp-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  }
}
